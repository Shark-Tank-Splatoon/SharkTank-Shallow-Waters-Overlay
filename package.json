{
    "name": "SharkTank-Shallow-Waters-Overlay",
    "version": "0.0.0",
    "compatibleDashboardVersion": "~4.21.0",
    "compatibleGameVersions": [
        "SPLATOON_3"
    ],
    "description": "NodeCG overlay for the Shark Tank Shallow Waters Splatoon 3 tournament",
    "author": {
        "name": "polonbear",
        "email": "polon@polonbear.com"
    },
    "files": [
        "graphics",
        "dashboard"
    ],
    "keywords": [
        "nodecg-bundle",
        "splatoon-3",
        "broadcast-overlay",
        "shark-tank"
    ],
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch"
    },
    "nodecg": {
        "compatibleRange": "^1.7.0 || ^2.0.0",
        "graphics": [
            {
                "file": "break.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "ingame.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "replay.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "end.html",
                "width": 1920,
                "height": 1080
            }
        ],
        "dashboardPanels": [
            {
                "name": "SharkTankSettings",
                "title": "Shark Tank Settings",
                "width": 2,
                "file": "dist/sharktankdashboard.html",
                "workspace": "sharktank",
                "headerColor": "#1E90FF"
            },
            {
                "name": "EndSceneCommentators",
                "title": "End Scene Commentators",
                "width": 2,
                "file": "end-scene-commentators/end-scene-commentators.html",
                "workspace": "sharktank",
                "headerColor": "#1E90FF"
            },
            {
                "name": "ThemeSettings",
                "title": "Look & Feel (Colours & Sizes)",
                "width": 3,
                "file": "theme-settings/theme-settings.html",
                "workspace": "sharktank",
                "headerColor": "#1E90FF"
            }
        ],
        "bundleDependencies": {
            "ipl-overlay-controls": "^4.21.0"
        }
    },
    "dependencies": {
        "@iplsplatoon/vue-components": "^3.12.0",
        "@tourneyview/renderer": "0.8.0",
        "fitted-text": "^1.0.0",
        "gsap": "^3.13.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.11",
        "ts-nodecg": "^0.3.1",
        "vite": "^8.3.8"
    },
    "repository": "https://github.com/nodecg/nodecg.git",
    "license": "MIT"
}
